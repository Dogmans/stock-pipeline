FINANCIAL_MODELING_PREP_API_KEY=replace_with_your_key
# Exact browser origins, comma-separated; no paths. Include each hostname/IP you use.
STOCK_PIPELINE_ALLOWED_ORIGINS=http://192.168.1.50:8765,http://stock-server:8765
# Optional: bind the published port to one host interface instead of all interfaces.
STOCK_PIPELINE_BIND_ADDRESS=0.0.0.0
